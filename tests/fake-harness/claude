#!/usr/bin/env bash
# Fake claude for tests: short calls (Constable, Watch) go to the fake pi; any run succeeds.
for a in "$@"; do
  case "$a" in *"Answer with a single JSON object:"*|*"Rate the difficulty of this task."*) exec "$(dirname "$0")/pi" "$@";; esac
done
model=""; effort=""
while [ $# -gt 0 ]; do
  case "$1" in --model) model=$2; shift;; --effort) effort=$2; shift;; esac
  shift
done
echo "fake claude: $model effort $effort: work done"
touch "$PWD/done-$model-$effort"
exit 0
